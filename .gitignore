# -----------------------------
# Terraform
# -----------------------------

# Local .terraform directories
.terraform/

# Terraform lock and state files
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Crash logs
crash.log

# Ignore all backup files
*.backup
*.bak

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Plan files
*.tfplan

# -----------------------------
# VS Code
# -----------------------------
.vscode/
.history/
*.code-workspace

# -----------------------------
# Operating System Files
# -----------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini


# -----------------------------
# Python (if you use scripts)
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# -----------------------------
# Logs & Temp Files
# -----------------------------
*.log
*.tmp
~$*
